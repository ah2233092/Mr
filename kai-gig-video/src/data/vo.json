 "voice": "am_michael:0.7,am_fenrir:0.3",
 "lines": [
  {
   "i": 0,
   "scene": "hook",
   "text": "Your book could be perfect…",
   "start": 0.35,
   "end": 1.805
  },
  {
   "i": 1,
   "scene": null,
   "text": "and still never sell a single copy.",
   "start": 2.355,
   "end": 4.599
  },
  {
   "i": 2,
   "scene": "twist",
   "text": "Not because of your writing.",
   "start": 5.399,
   "end": 6.784
  },
  {
   "i": 3,
   "scene": null,
   "text": "Because of everything around it.",
   "start": 7.104,
   "end": 8.766
  },
  {
   "i": 4,
   "scene": "problems",
   "text": "A wrong margin gets it sent back.",
   "start": 9.466,
   "end": 11.322
  },
  {
   "i": 5,
   "scene": null,
   "text": "A weak cover gets it skipped.",
   "start": 11.662,
   "end": 13.214
  },
  {
   "i": 6,
   "scene": null,
   "text": "The wrong keywords bury it on page fifty.",
   "start": 13.614,
   "end": 15.863
  },
  {
   "i": 7,
   "scene": "turn",
   "text": "So I handle all of it, in one place.",
   "start": 16.713,
   "end": 18.805
  },
  {
   "i": 8,
   "scene": "publish",
   "text": "I publish your book on Amazon KDP, Kindle, paperback and hardcover.",
   "start": 19.605,
   "end": 24.45
  },
  {
   "i": 9,
   "scene": "format",
   "text": "I format it so Amazon KDP approves it, not sends it back.",
   "start": 24.95,
   "end": 29.224
  },
  {
   "i": 10,
   "scene": "cover",
   "text": "I design a cover that makes readers stop scrolling.",
   "start": 29.724,
   "end": 32.356
  },
  {
   "i": 11,
   "scene": "keywords",
   "text": "I find the keywords that help readers find you on Amazon.",
   "start": 32.856,
   "end": 36.126
  },
  {
   "i": 12,
   "scene": "aplus",
   "text": "And I build A+ Content that turns visitors into buyers.",
   "start": 36.626,
   "end": 40.198
  },
  {
   "i": 13,
   "scene": "proof",
   "text": "I've published over 1,000 books on Amazon KDP, and I know what works.",
   "start": 40.998,
   "end": 46.352
  },
  {
   "i": 14,
   "scene": "close",
   "text": "You wrote the book.",
   "start": 47.152,
   "end": 48.165
  },
  {
   "i": 15,
   "scene": null,
   "text": "Let me take care of everything else.",
   "start": 48.585,
   "end": 50.508
  },
  {
   "i": 16,
   "scene": "cta",
   "text": "Before you hit upload on Amazon KDP, send me your book details.",
   "start": 51.358,
   "end": 56.009
  },
  {
   "i": 17,
   "scene": null,
   "text": "Only here on Fiverr.",
   "start": 56.389,
   "end": 57.626
  }
 ],
