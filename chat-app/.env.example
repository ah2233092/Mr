# ================================================================
#  ChatGPT (personal) — settings. Copy this file to ".env" and fill it in.
#  NEVER put these keys in frontend code or commit .env to GitHub.
# ================================================================

# ---------- App ----------
APP_NAME=ChatGPT
PORT=3000
# Your public address, e.g. https://chat.example.com (needed for Google login + reset emails)
PUBLIC_URL=
# Domain used by docker-compose/Caddy for automatic HTTPS
DOMAIN=chat.example.com
# Comma-separated emails that see the Admin panel
ADMIN_EMAILS=you@example.com
ALLOW_SIGNUP=true

# ================================================================
#  AI MODELS — add any of these. Each key you add switches that
#  provider on, and its models appear in the app automatically.
# ================================================================

# --- OmniRoute (PRIMARY ENGINE) — one gateway in front of many providers ---
# docker-compose starts it for you at http://omniroute:20128/v1. Running locally: http://localhost:20128/v1
# Connect providers in the OmniRoute dashboard (official API keys only), then copy a key from Dashboard -> Endpoints.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
# OmniRoute security (used by docker-compose). Generate:  openssl rand -base64 48  /  openssl rand -hex 32
OMNIROUTE_DASHBOARD_PASSWORD=
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
# Extra official API providers to allow through OmniRoute (OmniRoute provider ids, comma-separated)
OMNIROUTE_ALLOW_PROVIDERS=
# Image model to use through OmniRoute (copy the exact model id from its dashboard), e.g. a FLUX model
OMNIROUTE_IMAGE_MODEL=
# Optional: your own OmniRoute combo of OFFICIAL providers to use first for "Auto", e.g. combo/my-fast
# (OmniRoute's built-in auto/* combos are not used: they can route through unofficial keyless providers)
OMNIROUTE_AUTO_MODELS=
# Max simultaneous requests to OmniRoute
OMNIROUTE_CONCURRENCY=100

# --- Direct keys = emergency BACKUP if OmniRoute is ever down (recommended: Cerebras + Groq) ---
# --- FREE tiers (owner pays nothing within their limits) ---
# Cerebras: fastest replies (GPT-OSS 120B, Llama, Qwen)  https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Groq: very fast (GPT-OSS 120B/20B, Llama 3.3 70B, Llama 4)  https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini: smart + can see images  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: many ":free" models  https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Mistral: free "Experiment" plan  https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- ChatGPT models (shown FIRST in the menu; paid per use) ---
# OpenAI: GPT-6.x / GPT-5.x / o-series — every model your key can use appears automatically
# https://platform.openai.com/api-keys   Tip: set a monthly budget in the OpenAI dashboard (Settings → Limits)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Any other OpenAI-compatible server (Together, DeepInfra, Ollama, vLLM, ...) ---
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_LABEL=Custom
CUSTOM_TIER=free

# ---------- Images ----------
# Cloudflare Workers AI — FLUX, free daily allowance. Account ID + API token (Workers AI permission)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Together AI (FLUX)
TOGETHER_API_KEY=
# Pollinations works without a key; a key gives higher limits  https://enter.pollinations.ai
ENABLE_POLLINATIONS=true
POLLINATIONS_API_KEY=
# Gemini / OpenAI images use GEMINI_API_KEY / OPENAI_API_KEY above (usually paid)
GEMINI_IMAGES=true
OPENAI_IMAGES=true
OPENAI_IMAGE_MODEL=gpt-image-1
# Try order (first that works wins)
IMAGE_PROVIDERS=omniroute,cloudflare,together,gemini,pollinations,openai
# Rewrite prompts with AI before drawing (much better pictures)
IMAGE_PROMPT_ENHANCE=true

# ---------- Model list tuning (optional) ----------
# Model selected by default, e.g. openai:gpt-6.1-sol (empty = best ChatGPT model, or Auto without an OpenAI key)
DEFAULT_MODEL=
# Fixed order for "Auto", e.g. cerebras:gpt-oss-120b,groq:openai/gpt-oss-120b,gemini:gemini-2.5-flash
AUTO_MODELS=
# Shown under "Recommended" in the model menu
FEATURED_MODELS=
# Regex filters on "provider:model"
MODEL_ALLOW_REGEX=
MODEL_BLOCK_REGEX=
MAX_MODELS_PER_PROVIDER=14
MAX_OPENAI_MODELS=40
# Skip discovery and use a fixed list for one provider, e.g. OPENAI_MODELS=gpt-6-sol,gpt-5.1
# OPENAI_MODELS=

# ---------- Per-user limits: 0 = UNLIMITED (default) ----------
USER_MSGS_PER_DAY=0
USER_PAID_MSGS_PER_DAY=0
USER_IMAGES_PER_DAY=0
USER_MSGS_PER_MINUTE=0
USER_CONCURRENT=0
# Max simultaneous requests sent to ONE provider (others wait in a fair queue)
PROVIDER_CONCURRENCY=32

# ---------- Login extras ----------
# Google sign-in: create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  {PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Password-reset emails via https://resend.com
RESEND_API_KEY=
MAIL_FROM=ChatGPT <no-reply@example.com>

# ---------- Testing only ----------
# Fake AI that answers instantly — never enable in production
ENABLE_MOCK=false
