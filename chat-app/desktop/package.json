{
  "name": "chatgpt-desktop",
  "productName": "Sukhan AI Pro",
  "version": "1.0.0",
  "description": "Personal multi-model AI chat — desktop app",
  "author": "Personal",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.personal.chatgpt",
    "productName": "Sukhan AI Pro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "app/server"
      },
      {
        "from": "../public",
        "to": "app/public"
      },
      {
        "from": "../package.json",
        "to": "app/package.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sukhan AI Pro",
      "artifactName": "Sukhan-AI-Pro-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "Sukhan-AI-Pro-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "Sukhan-AI-Pro-${version}.${ext}",
      "executableName": "sukhan-ai-pro"
    }
  },
  "repository": "https://github.com/ah2233092/Mr"
}
